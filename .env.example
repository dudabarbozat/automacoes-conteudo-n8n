# Variaveis de ambiente do n8n usadas por estes fluxos.
# Preencha os valores no seu ambiente; nunca versione o arquivo .env real.
# Credenciais de Google Drive, YouTube e OpenAI ficam no cofre de credenciais do n8n, nao aqui.

# Pasta onde os fluxos gravam temporarios (obrigatoria no n8n 2.x)
N8N_RESTRICT_FILE_ACCESS_TO=

# Tempo maximo de execucao, em segundos (os fluxos de cortes passam de 1 hora)
EXECUTIONS_TIMEOUT=

# Opcional: modo de armazenamento de binarios (database ou filesystem)
N8N_DEFAULT_BINARY_DATA_MODE=
